<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground.
  Asymmetric insets: more top-padding than bottom shifts the shield slightly DOWN
  inside the 108dp canvas (and inside the launcher's circular mask).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="18dp"
        android:bottom="6dp"
        android:left="12dp"
        android:right="12dp">
        <bitmap
            android:src="@drawable/ic_launcher_foreground_src"
            android:gravity="fill" />
    </item>
</layer-list>
