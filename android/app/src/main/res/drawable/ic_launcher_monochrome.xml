<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome adaptive-icon layer for Android 13+ Themed Icons.

  When the user turns on "Themed icons" in Material You, the launcher
  renders this flat silhouette tinted to match the system wallpaper
  (dark text on light accent background, or vice versa). The shape must
  be fully opaque where the shield exists and fully transparent elsewhere.

  Simple shield silhouette with a bold inset checkmark cut-out. Scaled
  to the 108dp adaptive canvas with a 20dp safe-zone margin so circular
  masks never clip the shield body.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FFFFFF">

    <!-- Shield outer silhouette: broader shoulders, pointed base.
         Starts at top-centre, down the right side, chevron-tapers to
         the point, back up the left side. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,22
                          C66,22 76,25.5 82,30
                          L82,56
                          C82,72 70,82 54,88
                          C38,82 26,72 26,56
                          L26,30
                          C32,25.5 42,22 54,22 Z" />

    <!-- Checkmark cut-out: punched through using fillColor transparent
         won't render in a monochrome layer; instead we use fillColor=white
         AND a slightly different stroke to make the check visible against
         the shield silhouette. -->
    <path
        android:fillColor="#000000"
        android:pathData="M44,56
                          L50,62
                          L68,44
                          L72.5,48.5
                          L50,71
                          L39.5,60.5 Z" />
</vector>
