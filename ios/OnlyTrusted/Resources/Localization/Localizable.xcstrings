        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains écrans se mettent à jour immédiatement ; d'autres se rafraîchissent à la prochaine ouverture de l'app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas telas são atualizadas instantaneamente; outras na próxima abertura do app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ स्क्रीन तुरंत अपडेट होती हैं; अन्य ऐप खोलने पर रीफ़्रेश होती हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض الشاشات تتحدث فورًا؛ وأخرى عند فتح التطبيق مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Bildschirme aktualisieren sich sofort; andere beim nächsten App-Start."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa layar diperbarui langsung; lainnya di pembukaan aplikasi berikutnya."
          }
        }
      }
