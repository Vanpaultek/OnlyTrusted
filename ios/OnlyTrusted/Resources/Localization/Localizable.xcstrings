    "monitor_text_idle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watching mic and camera. Nothing suspicious right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supervisando micrófono y cámara. Nada sospechoso ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillance du micro et de la caméra. Rien de suspect pour l'instant."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorando microfone e câmera. Nada suspeito agora."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक और कैमरा देख रहे हैं। अभी कुछ भी संदिग्ध नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نراقب الميكروفون والكاميرا. لا شيء مريب الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachtung von Mikrofon und Kamera. Derzeit nichts Verdächtiges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memantau mikrofon dan kamera. Tidak ada yang mencurigakan sekarang."
          }
        }
      }
    },
