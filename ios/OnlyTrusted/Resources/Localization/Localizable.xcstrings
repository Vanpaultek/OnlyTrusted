    "onb_pin_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup unlock for when your Passkey can't be presented. PBKDF2-hashed with 100k iterations before storing — we can't read it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueo de respaldo cuando tu Passkey no se puede usar. Se guarda con PBKDF2 (100k iteraciones) — no podemos leerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillage de secours quand votre Passkey ne peut pas être présenté. Stocké via PBKDF2 (100k itérations) — nous ne pouvons pas le relire."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueio de reserva quando seu Passkey não puder ser usado. Armazenado via PBKDF2 (100k iterações) — não podemos lê-lo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप अनलॉक जब आपकी Passkey उपयोग नहीं हो सकती। PBKDF2 (100k पुनरावृत्तियाँ) से हैश — हम इसे वापस नहीं पढ़ सकते।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح احتياطي عندما لا يمكن تقديم Passkey. مُهشَّم بـ PBKDF2 (100 ألف تكرار) — لا يمكننا قراءته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup-Entsperrung, wenn Ihr Passkey nicht verwendet werden kann. PBKDF2-gehasht (100k Iterationen) — wir können es nicht zurücklesen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembuka cadangan saat Passkey Anda tidak bisa digunakan. Di-hash dengan PBKDF2 (100k iterasi) — kami tidak bisa membacanya."
          }
        }
      }
    },
