    "dash_exit_duress_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be returned to the lock screen. Unlock with your real credential to see the real vault."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] Volverás a la pantalla de bloqueo. Desbloquea con tu credencial real para ver el cofre verdadero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] Vous retournerez à l'écran de verrouillage. Déverrouillez avec vos vrais identifiants pour voir le vrai coffre."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] Você voltará à tela de bloqueio. Desbloqueie com sua credencial real para ver o cofre verdadeiro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] आप लॉक स्क्रीन पर वापस आएँगे। असली वॉल्ट देखने के लिए असली क्रेडेंशियल से अनलॉक करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] ستعود إلى شاشة القفل. افتح باستخدام بياناتك الحقيقية لرؤية الخزنة الحقيقية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] Sie kehren zum Sperrbildschirm zurück. Entsperren Sie mit Ihren echten Anmeldedaten, um den echten Tresor zu sehen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] Anda akan kembali ke layar kunci. Buka dengan kredensial asli untuk melihat brankas asli."
          }
        }
      }
    },
