    "alert_untrusted_call_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is not in your family vault. Call was silenced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] %1$@ no está en tu bóveda familiar. La llamada fue silenciada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] %1$@ n'est pas dans votre coffre familial. L'appel a été mis en silence."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] %1$@ não está no seu cofre familiar. A chamada foi silenciada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] %1$@ आपके परिवार वॉल्ट में नहीं है। कॉल म्यूट कर दी गई।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] %1$@ ليس في خزنة العائلة. تم كتم المكالمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] %1$@ ist nicht in Ihrem Familientresor. Anruf wurde stummgeschaltet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] %1$@ tidak ada di brankas keluarga Anda. Panggilan telah dibisukan."
          }
        }
      }
    },
