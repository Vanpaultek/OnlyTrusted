    "blocked_no_numbers_added": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No numbers added yet. Tap + above to block a specific number on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has añadido números. Toca + arriba para bloquear uno específico en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun numéro ajouté. Touchez + ci-dessus pour bloquer un numéro spécifique."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum número adicionado. Toque + acima para bloquear um específico neste dispositivo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई नंबर नहीं जोड़ा। इस डिवाइस पर किसी विशिष्ट नंबर को ब्लॉक करने के लिए ऊपर + टैप करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُضف أي أرقام بعد. انقر + أعلاه لحظر رقم محدد على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Nummern hinzugefügt. Tippen Sie oben auf +, um eine bestimmte Nummer auf diesem Gerät zu blockieren."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada nomor ditambahkan. Ketuk + di atas untuk memblokir nomor spesifik di perangkat ini."
