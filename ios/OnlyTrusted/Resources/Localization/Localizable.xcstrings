    "events_audit_tampered_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event log hash chain is broken. An event may have been edited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] La cadena hash del registro está rota. Un evento puede haber sido editado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] La chaîne de hachage du journal est rompue. Un événement a peut-être été modifié."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] A cadeia hash do registro está quebrada. Um evento pode ter sido editado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] ईवेंट लॉग की हैश चेन टूटी हुई है। किसी ईवेंट को संपादित किया गया हो सकता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] سلسلة التجزئة لسجل الأحداث مقطوعة. ربما تم تعديل حدث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] Die Hash-Kette des Ereignisprotokolls ist gebrochen. Ein Ereignis wurde möglicherweise bearbeitet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] Rantai hash log kejadian terputus. Suatu kejadian mungkin telah diedit."
          }
        }
      }
    },
