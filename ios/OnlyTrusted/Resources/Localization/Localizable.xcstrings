    "onb_passkey_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID / Touch ID becomes your primary unlock — phishing-proof, nothing to type. Uses Secure Enclave; biometric never leaves this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rostro / huella se vuelve tu desbloqueo principal — a prueba de phishing, nada que escribir. Usa Keystore / StrongBox del hardware; tu biometría nunca sale de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le visage / empreinte devient votre déverrouillage principal — résistant au phishing, rien à taper. Utilise Keystore / StrongBox matériel ; votre biométrie ne quitte jamais cet appareil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O rosto / impressão digital se torna seu desbloqueio principal — à prova de phishing, nada para digitar. Usa Keystore / StrongBox do hardware; sua biometria nunca sai deste dispositivo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेहरा / फ़िंगरप्रिंट आपका मुख्य अनलॉक बन जाता है — फ़िशिंग-प्रूफ़, कुछ टाइप करने की ज़रूरत नहीं। हार्डवेयर Keystore / StrongBox का उपयोग करता है; आपकी बायोमेट्रिक्स इस डिवाइस से कभी बाहर नहीं जाती।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصبح الوجه / البصمة فتحك الأساسي — مقاوم للتصيد، لا شيء للكتابة. يستخدم Keystore / StrongBox العتاد؛ بياناتك الحيوية لا تغادر الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesicht / Fingerabdruck wird Ihre primäre Entsperrung — phishing-sicher, nichts zu tippen. Nutzt Hardware-Keystore / StrongBox; Biometrie verlässt dieses Gerät nie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wajah / sidik jari jadi pembuka utama Anda — anti-phishing, tidak perlu mengetik. Pakai Keystore / StrongBox perangkat keras; biometrik Anda tidak pernah keluar dari perangkat."
          }
        }
      }
    },
