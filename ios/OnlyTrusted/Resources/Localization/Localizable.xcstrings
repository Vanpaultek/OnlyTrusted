    "language_restart_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some screens update immediately; others refresh on next app open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas pantallas se actualizan al instante; otras se refrescan al abrir la app de nuevo."
