    "legal_auto_renew": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-renews at the price shown. Cancel anytime in App Store → Subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] Se renueva automáticamente al precio mostrado. Puedes cancelar en cualquier momento en Suscripciones de Google Play."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] Se renouvelle automatiquement au prix affiché. Annulez à tout moment dans les abonnements Google Play."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] Renova automaticamente pelo preço exibido. Cancele a qualquer momento em Assinaturas do Google Play."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] दिखाए गए मूल्य पर स्वतः नवीनीकरण। Google Play सदस्यताओं में कभी भी रद्द करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] يتجدد تلقائيًا بالسعر المعروض. يمكنك الإلغاء في أي وقت من اشتراكات Google Play."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] Verlängert sich automatisch zum angezeigten Preis. Jederzeit in Google-Play-Abos kündbar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "[REVIEW] Diperpanjang otomatis dengan harga yang ditampilkan. Batalkan kapan saja di Langganan Google Play."
          }
        }
      }
    },
