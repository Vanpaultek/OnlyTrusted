    "onb_email_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored on this device only. OnlyTrusted does not have a server, so your email is never transmitted anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda solo en este dispositivo. OnlyTrusted no tiene servidor, por lo que tu correo nunca se transmite a ningún lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocké uniquement sur cet appareil. OnlyTrusted n'a pas de serveur, donc votre e-mail n'est jamais transmis."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenado apenas neste dispositivo. OnlyTrusted não tem servidor, então seu e-mail nunca é transmitido."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल इस डिवाइस पर संग्रहीत। OnlyTrusted के पास सर्वर नहीं है, इसलिए आपका ईमेल कहीं नहीं भेजा जाता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخزَّن على هذا الجهاز فقط. لا يوجد خادم لـ OnlyTrusted، لذا لا يُرسل بريدك إلى أي مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur auf diesem Gerät gespeichert. OnlyTrusted hat keinen Server, Ihre E-Mail wird nie übertragen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan hanya di perangkat ini. OnlyTrusted tidak punya server, jadi email Anda tidak pernah dikirim ke mana pun."
          }
        }
      }
    },
